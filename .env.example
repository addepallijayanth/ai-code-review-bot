# Copy to .env and fill in. Never commit .env.

# GitHub App: Settings -> Developer settings -> GitHub Apps -> your app
GITHUB_APP_ID=
# The URL slug of the App (github.com/apps/<slug>); the bot comments as <slug>[bot]
GITHUB_APP_SLUG=
# The App's private key. Either paste the PEM on one line with \n between lines,
# or leave this empty and point GITHUB_PRIVATE_KEY_PATH at a mounted .pem file.
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_PATH=
# The webhook secret you entered in the App settings (e.g. `openssl rand -hex 32`)
WEBHOOK_SECRET=

# Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# HTTP Basic login for /dashboard
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
