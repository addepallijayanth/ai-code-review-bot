+import { ContactRepository } from "../repositories/contactRepository";
+import { ContactRow, toContact } from "../model/contact";
+
+/**
+ * Saves every row and returns the number of contacts imported.
+ */
+export async function importContacts(rows: ContactRow[], repo: ContactRepository): Promise<number> {
+  let imported = 0;
+  rows.forEach(async (row) => {
+    const contact = toContact(row);
+    await repo.save(contact);
+    imported++;
+  });
+  return imported;
+}
